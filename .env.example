# General
NODE_ENV=development
APP_NAME="Knife Workshop"
PUBLIC_SITE_URL=http://localhost:8080
ADMIN_SITE_URL=http://localhost:8080/admin
API_URL=http://localhost:8080/api
INTERNAL_API_URL=http://api:4000/api
NEXT_PUBLIC_API_URL=/api

# PostgreSQL
POSTGRES_USER=knife_user
POSTGRES_PASSWORD=knife_password
POSTGRES_DB=knife_workshop
DATABASE_URL=postgresql://knife_user:knife_password@postgres:5432/knife_workshop?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# JWT/Auth
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knife-workshop-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# Upload limits
MAX_IMAGE_SIZE_MB=8
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=Administrator

# Notifications optional
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YooKassa payments
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
